#!/bin/sh
# Run a lese picker headlessly and print what it shows. `lese-run --help` for
# the options; everything but --host and --rtp is read by lese.testing.cli.
#
# Arguments reach the editor through a file, NUL-separated, and directories
# through environment variables, so no shell or Ex quoting is involved.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
host=nvim
rtp=""
nl='
'
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
args="$tmp/args"
: >"$args"

add_rtp() {
  dir=$(CDPATH= cd -- "$1" && pwd)
  rtp="$rtp$dir$nl"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host=*) host=${1#--host=} ;;
    --host) shift; host=$1 ;;
    --rtp=*) add_rtp "${1#--rtp=}" ;;
    --rtp) shift; add_rtp "$1" ;;
    *) printf '%s\0' "$1" >>"$args" ;;
  esac
  shift
done

# Put lese, then each --rtp directory, in front of 'runtimepath'.
setup='let &rtp = escape($LESE_RUN_ROOT, ",") . "," . &rtp | for g:lese_run_dir in split($LESE_RUN_RTP, "\n") | let &rtp = escape(g:lese_run_dir, ",") . "," . &rtp | endfor'

run() {
  case "$1" in
    nvim)
      LESE_RUN_ROOT=$root LESE_RUN_RTP=$rtp LESE_RUN_ARGS_FILE=$args "${LESE_NVIM:-nvim}" --headless --clean \
        --cmd "$setup" -c 'lua require("lese.testing.cli").main()' </dev/null ;;
    vim)
      LESE_RUN_ROOT=$root LESE_RUN_RTP=$rtp LESE_RUN_ARGS_FILE=$args "${LESE_VIM:-vim}" -Nu NONE -i NONE -es \
        --cmd "$setup" -c 'lua require("lese.testing.cli").main()' </dev/null ;;
    *)
      echo "lese-run: unknown host '$1' (nvim, vim or both)" >&2
      return 2 ;;
  esac
}

case "$host" in
  both)
    status=0
    run nvim >"$tmp/nvim" 2>&1 || status=$?
    run vim >"$tmp/vim" 2>&1 || status=$?
    cat "$tmp/nvim"
    if ! diff -u --label nvim --label vim "$tmp/nvim" "$tmp/vim" >"$tmp/diff"; then
      echo "lese-run: Neovim and Vim printed different results:" >&2
      cat "$tmp/diff" >&2
      exit 3
    fi
    exit "$status" ;;
  *)
    run "$host" ;;
esac
